# SentinelAI configuration - copy to .env. Every key is optional; defaults give a working local setup
# (SQLite database, deterministic engine only, no external calls).

# --- Application --------------------------------------------------------------------------
SENTINEL_ENVIRONMENT=development          # development | staging | production | test
SENTINEL_RISK_REGIME=US_BSA               # US_BSA | IN_PMLA | EU_AMLD  (thresholds, SAR/STR rules and deadlines)

# --- LLM research layer (optional) ---------------------------------------------------------
SENTINEL_LLM_PROVIDER=ollama              # ollama | groq | huggingface
OLLAMA_API_KEY=                          # Ollama Cloud key (not needed for a local server)
OLLAMA_BASE_URL=https://ollama.com       # or http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b                # any model your account/server offers, e.g. glm-*, qwen3, deepseek
# GROQ_API_KEY=  /  SENTINEL_LLM_GROQ_MODEL=  (when SENTINEL_LLM_PROVIDER=groq)
SENTINEL_LLM_TEMPERATURE=0.0
SENTINEL_LLM_MAX_TOKENS=4096
SENTINEL_LLM_AGENT_TIMEOUT_S=90
# The LLM may ADD at most this many points to a score; it can never lower one.
SENTINEL_LLM_MAX_UPLIFT=15
# PRIVACY: web search is OFF by default. Enabling it sends (redacted) entity names to Tavily/DuckDuckGo.
SENTINEL_LLM_WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
SENTINEL_LLM_REDACT_PII=true

# --- Persistence ---------------------------------------------------------------------------
# SQLite file by default. For PostgreSQL set DATABASE_URL (postgres://... is accepted) or SENTINEL_DB_POSTGRES_HOST.
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinelai
# SENTINEL_DB_SQLITE_PATH=data/sentinelai.db
# SENTINEL_DB_AUTO_CREATE_TABLES=true     # set false and run `alembic upgrade head` in production
# Optional Redis: shared rate-limit counters and agent-result cache across workers.
# REDIS_URL=redis://localhost:6379/0

# --- API & security ------------------------------------------------------------------------
SENTINEL_API_HOST=0.0.0.0
PORT=8000
# Comma-separated name:role:key. Roles: viewer < analyst < admin. Unset in development = open access.
# In production with no keys the API fails closed (401) unless SENTINEL_API_PUBLIC_DEMO=true.
SENTINEL_API_KEYS=
SENTINEL_API_PUBLIC_DEMO=false
SENTINEL_API_CORS_ORIGINS=*
SENTINEL_API_RATE_LIMIT_REQUESTS=100
SENTINEL_API_RATE_LIMIT_PERIOD=60
SENTINEL_API_TRUST_PROXY=false            # true behind a reverse proxy so X-Forwarded-For is honoured

# --- Risk calibration (USD-equivalent amounts, scores 0-100) ----------------------------------
SENTINEL_RISK_MEDIUM_RISK_THRESHOLD=30
SENTINEL_RISK_HIGH_RISK_THRESHOLD=60
SENTINEL_RISK_CRITICAL_RISK_THRESHOLD=80
SENTINEL_RISK_SAR_SCORE_THRESHOLD=60
SENTINEL_RISK_SANCTIONS_MATCH_THRESHOLD=0.92
SENTINEL_RISK_SANCTIONS_REVIEW_THRESHOLD=0.85
# SENTINEL_RISK_FX_RATES={"INR":0.0113}
# SENTINEL_RISK_JURISDICTIONS_FILE=/path/to/jurisdictions.json
# SENTINEL_RISK_LISTS_DIR=data/lists        # `sentinelai sanctions update` writes OFAC files to <dir>/ofac

# --- Logging & metrics ----------------------------------------------------------------------
SENTINEL_MONITOR_LOG_LEVEL=INFO
SENTINEL_MONITOR_LOG_FORMAT=json          # json | text
# SENTINEL_MONITOR_LOG_FILE=logs/sentinelai.log
SENTINEL_MONITOR_METRICS_ENABLED=true
